# ── フロントエンド（Vite） ──────────────────────────────
# Supabase プロジェクトのURL / anonキー
VITE_SUPABASE_URL=https://xxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# LIFFアプリのID。未設定（or "mock"）の場合はダミーユーザーで動作（ローカル開発用）
VITE_LIFF_ID=

# 管理画面（/admin）のログインパスワード
VITE_ADMIN_PASSWORD=your-admin-password

# 大会運営者の個人LINE友だち追加URL（エントリー完了画面で案内。未設定なら非表示）
VITE_ORGANIZER_LINE_URL=

# ── サーバーサイド（Vercel Functions のみ） ──────────────
# Messaging API のチャネルアクセストークン（申込控えの送信に使用）
LINE_CHANNEL_ACCESS_TOKEN=

# 管理者の個人LINEユーザーID
#   - エントリー通知の受信
#   - 管理画面「LINE表示名を一括送信」の送信先
ADMIN_LINE_USER_ID=

# 大会運営者の個人LINE友だち追加URL（エントリー通知メッセージに記載。未設定なら非表示）
# VITE_ORGANIZER_LINE_URL と同じURLを設定してください
ORGANIZER_LINE_URL=

# keep-alive cron の認証シークレット（Supabase無料枠の一時停止対策）
CRON_SECRET=your-cron-secret
